# ─────────────────────────────────────────────────────────────────────────────
# TerraScope environment configuration
#
# EVERY value below is OPTIONAL. TerraScope ships with public, key-free
# endpoints and works with an empty environment. Copy this file to `.env.local`
# only if you want to raise rate limits or point at a mirror.
#
# Nothing in this file is read by the browser: all of it is consumed inside
# Next.js route handlers (`src/app/api/*`), so no credential is ever bundled
# into client-side JavaScript.
# ─────────────────────────────────────────────────────────────────────────────

# Public site URL — used for absolute URLs in metadata / Open Graph tags.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── OpenSky Network ──────────────────────────────────────────────────────────
# Anonymous access works but is throttled (roughly 400 credits/day for the
# /states/all endpoint). Registering an OAuth2 client lets TerraScope request
# an access token server-side and raises the limit substantially.
# Create credentials at: https://opensky-network.org/my-opensky/account
OPEN_SKY_CLIENT_ID=
OPEN_SKY_CLIENT_SECRET=
OPEN_SKY_BASE_URL=https://opensky-network.org/api
OPEN_SKY_TOKEN_URL=https://auth.opensky-network.org/auth/realms/opensky-network/protocol/openid-connect/token

# ── USGS Earthquake Hazards Program (no key required) ────────────────────────
USGS_FEED_BASE_URL=https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary

# ── NASA EONET v3 (no key required) ──────────────────────────────────────────
EONET_BASE_URL=https://eonet.gsfc.nasa.gov/api/v3
# NASA EONET occasionally serves a self-signed certificate chain. Leave this
# `false` unless your deployment genuinely requires relaxed TLS.
EONET_ALLOW_INSECURE_TLS=false

# ── Open-Meteo forecast + air quality (no key required) ──────────────────────
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_AIR_QUALITY_URL=https://air-quality-api.open-meteo.com/v1/air-quality

# ── Nominatim geocoding (no key required) ────────────────────────────────────
# The Nominatim usage policy requires an identifying User-Agent and recommends
# a contact address. TerraScope enforces a >=1.1s gap between outbound calls.
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=TerraScope/1.0 (+https://github.com/ngl-ankit/TerraScope)
NOMINATIM_EMAIL=

# ── Server-side cache tuning (seconds) ───────────────────────────────────────
CACHE_TTL_EARTHQUAKES=45
CACHE_TTL_EONET=180
CACHE_TTL_FLIGHTS=12
CACHE_TTL_AIR_QUALITY=600
CACHE_TTL_GEOCODE=300

# Weather forecast cache (seconds) — per ~1km coordinate cell.
CACHE_TTL_WEATHER=600
