{
  "name": "terrascope",
  "version": "1.0.0",
  "private": true,
  "description": "TerraScope - an interactive 3D Earth platform streaming live earthquake, natural-event, weather, flight and air-quality data from public APIs.",
  "keywords": [
    "earth",
    "geospatial",
    "three.js",
    "next.js",
    "usgs",
    "eonet",
    "open-meteo",
    "opensky"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "data:borders": "node scripts/build-borders.mjs",
    "render_build": "npm run borders && next build"
  },
  "dependencies": {
    "@react-three/drei": "^10.0.6",
    "@react-three/fiber": "^9.1.0",
    "lucide-react": "^0.475.0",
    "next": "^15.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.174.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@types/three": "^0.174.0",
    "@types/topojson-client": "^3.1.5",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "topojson-client": "^3.1.0",
    "typescript": "^5.9.3",
    "world-atlas": "^2.0.2"
  },
  "engines": {
    "node": "22.x",
    "npm": ">=10"
  }
}
